<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up by Android: the account's data lives on the server and syncs back after sign-in,
     and a restored sign-in token or half-synced queue on a new phone would do more harm than good. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
