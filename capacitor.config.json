{
  "appId": "co.za.getfitdaily.app",
  "appName": "GFD",
  "webDir": "build/app",
  "loggingBehavior": "debug",
  "android": {
    "flavor": "prod",
    "allowMixedContent": false,
    "captureInput": false,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https",
    "hostname": "localhost"
  },
  "plugins": {
    "SystemBars": { "insetsHandling": "native", "initialViewportFitValueHint": "cover" },
    "LocalNotifications": { "smallIcon": "ic_stat_gfd", "iconColor": "#D4FF3A" }
  }
}
